{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "web-app",
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "port": 5000,
      "cwd": "backend",
      "autoPort": false
    },
    {
      "name": "acceptance-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "test/access/acceptance/browser/start-api.cjs"
      ],
      "port": 5100,
      "cwd": "backend",
      "autoPort": false
    },
    {
      "name": "acceptance-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../backend/test/access/acceptance/browser/start-web.cjs"
      ],
      "port": 3100,
      "cwd": "web-app",
      "autoPort": false
    }
  ]
}