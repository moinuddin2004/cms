

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SSL: true (default, managed hosts like Neon) | verify (check certificate) | false (local Postgres)
DATABASE_SSL=true

# Server
PORT=5000
NODE_ENV=development

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here

# Google sign-in (Google Identity Services ID token). Only the OAuth client
# id is needed; add the web app origin (e.g. http://localhost:3000) under
# "Authorized JavaScript origins" in Google Cloud Console. Unset = the
# "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=your_google_client_id

# Email
EMAIL_TOKEN_SECRET=your_email_token_secret
RESET_TOKEN_SECRET=your_reset_token_secret
# Any free SMTP. Gmail: leave SMTP_HOST empty, SMTP_USER = the Gmail address,
# SMTP_PASS = an app password, SMTP_FROM = the same Gmail address.
# Brevo / SMTP2GO / Mailjet: set SMTP_HOST (+ port) and their SMTP login.
# Nothing set = emails are only logged (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=
SMTP_FROM_NAME=Clinic Portal
# Links in emails point here
FRONTEND_URL=http://localhost:3000
# Notification emails per day (free plans: Gmail ~500, Brevo 300); 0 = no cap.
# Over the cap they wait for the next day; account emails are never held.
EMAIL_DAILY_CAP=450


# File storage provider (chosen in src/common/storage/storage.config.ts). Default: cloudinary
STORAGE_DRIVER=cloudinary
# Cloudinary (file uploads: logos, documents, avatars) — from Cloudinary Console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
