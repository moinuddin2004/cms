{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clinic Management",
  "version": "0.1.0",
  "identifier": "com.levo.clinic-management",
  "build": {
    "beforeDevCommand": "npm --prefix ../web-app run dev -- --strictPort --host",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../web-app run build",
    "frontendDist": "../../web-app/.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Clinic Management",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["clinic"]
      }
    }
  }
}
