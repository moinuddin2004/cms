erDiagram
    organizations ||--o{ locations : "has"
    organizations ||--o{ organization_ownership : "owned through"
    users ||--o{ organization_ownership : "owns"
    locations ||--o| location_settings : "configured by"
    organizations ||--o{ employment_roles : "defines"
    employees ||--o{ employee_org_location_assignments : "works through"
    organizations ||--o{ employee_org_location_assignments : "employs"
    locations ||--o{ employee_org_location_assignments : "staffs"
    employment_roles |o--o{ employee_org_location_assignments : "grants"
    users |o--o{ employee_org_location_assignments : "logs in as"
    organizations {
        uuid id PK
        varchar slug
        int access_version
        boolean is_active
    }
    locations {
        uuid id PK
        uuid organization_id FK
        varchar code
        varchar timezone
        boolean is_active
    }
    location_settings {
        uuid id PK
        uuid location_id FK
        decimal tax_rate
    }
    organization_ownership {
        uuid id PK
        uuid user_id FK
        uuid organization_id FK
        boolean is_primary_owner
    }
    users {
        uuid uuid PK
        varchar email
        varchar global_role
    }
    employees {
        uuid id PK
        varchar full_name
        varchar phone
    }
    employee_org_location_assignments {
        uuid id PK
        uuid employee_id FK
        uuid organization_id FK
        uuid location_id FK
        uuid employment_role_id FK
        uuid user_id FK
        boolean has_portal_access
        boolean is_active
    }
    employment_roles {
        uuid id PK
        uuid organization_id FK
        jsonb permissions
        varchar template_key
    }
