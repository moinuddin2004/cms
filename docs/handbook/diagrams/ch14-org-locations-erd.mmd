erDiagram
  organizations ||--o{ locations : "has"
  organizations ||--o| organization_settings : "configured by"
  locations ||--o| location_settings : "configured by"
  organizations |o--o{ location_settings : "scopes"
  organizations ||--o{ organization_ownership : "owned via"
  users ||--o{ organization_ownership : "owns"
  organizations ||--o{ subscription_payments : "pays"
  organizations |o..o{ config_values : "scope_id when org"
  locations |o..o{ config_values : "scope_id when location"
  organizations {
    uuid id PK
    varchar slug UK
    enum subscription_plan
    timestamptz trial_ends_at
    timestamptz paid_until
    int access_version
  }
  organization_ownership {
    uuid id PK
    uuid user_id FK
    uuid organization_id FK
    bool is_primary_owner
  }
  organization_settings {
    uuid id PK
    uuid organization_id FK
    bool allow_location_override
    int default_slot_duration
  }
  locations {
    uuid id PK
    uuid organization_id FK
    varchar code
    varchar timezone
    bool is_active
  }
  location_settings {
    uuid id PK
    uuid location_id FK
    uuid organization_id FK
    numeric tax_rate
  }
  subscription_payments {
    uuid id PK
    uuid organization_id FK
    enum plan
    numeric amount
    timestamptz period_end
  }
  config_values {
    uuid id PK
    enum scope_type
    uuid scope_id
    varchar key
    bool is_locked
  }
  users {
    uuid uuid PK
  }
