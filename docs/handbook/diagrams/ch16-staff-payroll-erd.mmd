  employee_schedules {
    uuid id PK
    uuid employee_id FK
    uuid location_id FK
    int day_of_week
    bool is_working
  }
  employee_leaves {
    uuid id PK
    uuid employee_id FK
    uuid location_id FK
    enum leave_type
    enum status
  }
  doctor_availability_overrides {
    uuid id PK
    uuid employee_id FK
    uuid location_id FK
    date date
    bool is_available
  }
  payroll_records {
    uuid id PK
    uuid employee_id FK
    uuid location_id FK
    int month
    int year
    bigint total_minor
    enum status
