    uuid id PK "uuid v7"
    uuid organization_id FK
    uuid clinic_treatment_id FK
    uuid lab_service_id FK
    bool is_default
  }
  order_templates {
    uuid id PK "uuid v7"
    uuid organization_id FK
    uuid owner_user_id "no FK"
    jsonb template_json
  }
