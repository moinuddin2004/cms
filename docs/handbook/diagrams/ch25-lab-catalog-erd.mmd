    uuid id PK "uuid v7"
    uuid lab_id FK
    uuid category_id FK
    varchar code "unique per lab"
    enum unit_type
    int default_turnaround_days
  }
  lab_service_options {
    uuid id PK "uuid v7"
    uuid lab_service_id FK
    enum option_type
    bigint extra_cost_minor
  }
  lab_service_prices {
    uuid id PK "uuid v7"
    uuid lab_service_id FK
    uuid organization_id FK "null = list price"
