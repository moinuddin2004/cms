erDiagram
  specialties ||--o{ organization_specialties : "switched on, RESTRICT"
  specialties ||--o{ form_schemas : "RESTRICT"
  form_schemas ||--o{ form_schema_versions : "versions, RESTRICT"
  specialties ||--o{ stage_templates : "RESTRICT"
  stage_templates ||--o{ stage_template_steps : "steps, CASCADE"
  specialties ||--o{ workflow_templates : "RESTRICT"
  workflow_templates ||--o{ workflow_template_versions : "versions, RESTRICT"
  workflow_template_versions ||--o{ workflow_states : "RESTRICT"
  workflow_template_versions ||--o{ workflow_transitions : "RESTRICT"
  workflow_states ||--o{ workflow_transitions : "from state, RESTRICT"
  workflow_states ||--o{ workflow_transitions : "to state, RESTRICT"
  workflow_transitions ||--o{ transition_effects : "runs, RESTRICT"
  workflow_effects ||--o{ transition_effects : "handler, RESTRICT"
  specialties {
    uuid id PK "uuid v7"
    varchar code UK
    bool enabled_by_default
  }
  organization_specialties {
    uuid organization_id PK
    uuid specialty_id PK
    bool is_enabled
  }
  form_schemas {
    uuid id PK "uuid v7"
    uuid organization_id FK "null = platform"
    varchar code
  }
  form_schema_versions {
    uuid id PK "uuid v7"
    uuid form_schema_id FK
    int version_no
    jsonb schema_json
    enum status
  }
  stage_templates {
    uuid id PK "uuid v7"
    uuid organization_id FK "null = platform"
    varchar code
  }
  stage_template_steps {
    uuid id PK
    uuid stage_template_id FK
    int seq
    varchar code
  }
  workflow_templates {
    uuid id PK "uuid v7"
    uuid organization_id FK "null = platform"
    enum entity_type
    varchar code
  }
  workflow_template_versions {
    uuid id PK
    uuid workflow_template_id FK
    int version_no
    jsonb definition_json
    enum status
  }
  workflow_states {
    uuid id PK
    uuid template_version_id FK
    varchar code
    enum category
  }
  workflow_transitions {
    uuid id PK
    uuid from_state_id FK
    uuid to_state_id FK
    varchar action_code
  }
  transition_effects {
    uuid transition_id PK
    varchar effect_code PK
    int seq
  }
  workflow_effects {
    varchar code PK
    bool is_financial
    bool is_available
  }
