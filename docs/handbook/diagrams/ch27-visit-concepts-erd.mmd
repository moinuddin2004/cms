erDiagram
  patients ||--o{ appointments : "books, CASCADE"
  patients ||--o{ queue_entries : "waits as, CASCADE"
  appointments |o--o{ queue_entries : "checked in as, CASCADE"
  queue_entries ||--o| patient_encounters : "consulted in, CASCADE"
  appointments |o--o{ patient_encounters : "booked visit, SET NULL"
  patients ||--o{ patient_encounters : "CASCADE"
  patient_encounters |o--o{ treatments : "performed in, SET NULL"
  patient_encounters |o..o{ charges : "encounter_id, no FK"
  patients ||--o{ patient_visits : "summary per location, CASCADE"
  appointments {
    uuid id PK
    uuid patient_id FK
    uuid doctor_id FK
    enum status
  }
  queue_entries {
    uuid id PK
    uuid appointment_id FK
    int token_number
    enum status
  }
  patient_encounters {
    uuid id PK
    uuid queue_entry_id FK "unique"
    uuid appointment_id FK
    text diagnosis
  }
  patient_visits {
    uuid id PK
    uuid location_id FK
    date first_visit_date
    date last_visit_date
    numeric total_spent
  }
  treatments {
    uuid id PK
    uuid encounter_id FK
  }
  charges {
    uuid id PK
    uuid encounter_id
  }
  patients {
    uuid id PK
  }
