erDiagram
    queue_entries ||--o| patient_encounters : "starts"
    appointments |o--o{ patient_encounters : "books"
    patients ||--o{ patient_encounters : "has"
    locations ||--o{ patient_encounters : "hosts"
    patient_encounters |o--o{ treatments : "records"
    patients ||--o{ treatments : "receives"
    plan_templates |o--o{ treatments : "follows"
    services |o..o{ treatments : "prices"
    patient_encounters |o--o{ prescriptions : "issues"
    patient_encounters |o..o{ charges : "bills"

    patient_encounters {
        uuid id PK
        uuid queue_entry_id FK "unique"
        uuid appointment_id FK "null for walk-ins"
        uuid patient_id FK
        uuid location_id FK
        timestamptz encounter_date
        text diagnosis
        date follow_up_date
    }
    treatments {
        uuid id PK
        uuid patient_id FK
        uuid encounter_id FK "nullable"
        uuid plan_template_id FK "nullable"
        uuid service_id "logical, no FK"
        varchar treatment_name
        decimal cost "legacy fee"
    }
    charges {
        uuid id PK
        uuid encounter_id "logical"
        varchar source "CONSULTATION or TREATMENT"
        uuid source_id "logical"
    }
    prescriptions {
        uuid id PK
        uuid encounter_id FK "nullable"
        varchar status
    }
