    lab_services {
        uuid id PK
        uuid lab_id FK
        uuid service_category_id FK
        uuid form_schema_id FK
        uuid workflow_template_id FK
        uuid stage_template_id FK
        varchar code
        enum unit_type
        int default_turnaround_days
    }
    lab_service_prices {
        uuid id PK
        uuid lab_service_id FK
        uuid organization_id FK
        bigint unit_price_minor
        bigint rush_surcharge_minor
        date effective_from
        date effective_to
        timestamptz voided_at
    }
    lab_service_options {
        uuid id PK
        uuid lab_service_id FK
        varchar code
        bigint extra_cost_minor
    }
    service_mappings {
        uuid id PK
        uuid organization_id FK
        uuid clinic_treatment_id FK
        uuid lab_service_id FK
        bool is_default
        bool is_active
    }
    order_templates {
        uuid id PK
        uuid organization_id FK
        uuid lab_id FK
        uuid owner_user_id
        jsonb template_json
        int use_count
    }
