erDiagram
  users ||--o{ organization_ownership : "owns through"
  organizations ||--o{ organization_ownership : "owned by"
  organizations ||--o{ locations : "has"
  locations ||--o| location_settings : "configured by"
  organizations ||--o{ subscription_payments : "paid by"
  organizations ||--o{ employee_org_location_assignments : "counts logins"
  users {
    uuid uuid PK
    text email
    text email_verification_token
    timestamptz email_verified_at
  }
  organizations {
    uuid id PK
    enum subscription_plan
    timestamptz trial_ends_at
    timestamptz paid_until
    int max_locations
    bool onboarding_pending
  }
  organization_ownership {
    uuid id PK
    uuid organization_id FK
    uuid user_id FK
  }
  locations {
    uuid id PK
    uuid organization_id FK
    text code
    bool is_main_branch
  }
  location_settings {
    uuid id PK
    uuid location_id FK
    numeric tax_rate
  }
  subscription_payments {
    uuid id PK
    uuid organization_id FK
    enum plan
    int months
    numeric amount
    timestamptz period_end
  }
  employee_org_location_assignments {
    uuid id PK
    uuid organization_id FK
    uuid user_id
    bool is_active
  }
