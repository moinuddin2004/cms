---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import AllFeatures from './AllFeatures.astro';

const bars = [38, 46, 41, 55, 52, 61, 58, 66, 63, 72, 69, 81];
---

<section class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <SectionHead eyebrow="Features">
      <Fragment slot="lead">A whole clinic.</Fragment>
      <Fragment slot="rest">One app.</Fragment>
      Everything from the front desk to the owner’s reports, sharing the same patient record.
    </SectionHead>

    <div class="mt-16 grid gap-4 lg:grid-cols-3">
      <!-- Consultation (wide) -->
      <article class="reveal flex flex-col rounded-[28px] bg-panel p-8 lg:col-span-2">
        <h3 class="heading-6">The whole visit on one screen.</h3>
        <p class="body-6 mt-2 max-w-md text-steel">Vitals, history, notes, prescription and treatment plan side by side. It saves as the doctor types.</p>
        <div class="mt-auto grid gap-3 pt-8 sm:grid-cols-[1fr_1.3fr]" aria-hidden="true">
          <div class="rounded-2xl bg-surface p-4">
            <div class="flex items-center gap-3">
              <span class="caption-3 grid size-9 place-items-center rounded-full bg-panel">MA</span>
              <div>
                <p class="body-4">Mehwish Ali</p>
                <p class="caption-5 text-steel">34 years · Follow up</p>
              </div>
            </div>
            <div class="mt-4 grid grid-cols-3 gap-2">
              {[['BP', '128/84'], ['Pulse', '76'], ['Temp', '98.9°F']].map(([k, v]) => (
                <div class="rounded-lg bg-panel px-2 py-2">
                  <p class="caption-5 text-steel">{k}</p>
                  <p class="caption-3 printed">{v}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="rounded-2xl bg-surface p-4">
            <div class="flex items-center justify-between">
              <p class="caption-4 text-steel">Prescription</p>
              <p class="caption-4 flex items-center gap-1 text-steel"><Icon name="check" class="size-3 text-brand" />Saved</p>
            </div>
            <p class="body-4 mt-3">Tab. Amlodipine 5 mg</p>
            <p class="caption-5 text-steel">1 + 0 + 0 · 30 days</p>
            <p class="caption-2 mt-2" dir="rtl" lang="ur">صبح ایک گولی، تیس دن تک</p>
          </div>
        </div>
      </article>

      <!-- Reports (accent) -->
      <article class="reveal flex flex-col rounded-[28px] bg-ink p-8 text-on-ink">
        <p class="heading-1 printed">37</p>
        <h3 class="title-1 mt-4">reports, ready to export</h3>
        <p class="body-6 mt-2 opacity-70">From the day’s collection to profit and loss by branch. Excel or PDF.</p>
        <div class="mt-auto flex h-16 items-end gap-1 pt-8" aria-hidden="true">
          {bars.map((h, idx) => (
            <span class={`flex-1 rounded-sm ${idx === bars.length - 1 ? 'bg-brand' : 'bg-on-ink/20'}`} style={`height:${h}%`} />
          ))}
        </div>
      </article>

      <!-- Billing -->
      <article class="reveal flex flex-col rounded-[28px] bg-panel p-8 lg:col-span-2">
        <h3 class="heading-6">Bill before they leave.</h3>
        <p class="body-6 mt-2 text-steel">Visit charges flow into the invoice. Discounts, packages, refunds and tax at your branch rate.</p>
        <ul class="mt-auto flex flex-wrap gap-2 pt-8" aria-hidden="true">
          {['Cash', 'JazzCash', 'Bank transfer', 'Packages', 'Refunds'].map((m) => (
            <li class="caption-1 rounded-full bg-surface px-3 py-1">{m}</li>
          ))}
        </ul>
      </article>

      <!-- Branches -->
      <article class="reveal flex flex-col rounded-[28px] bg-panel p-8">
        <p class="heading-1 printed">3</p>
        <h3 class="title-1 mt-4">branches on Professional</h3>
        <p class="body-6 mt-2 text-steel">Each branch keeps its own timings, settings and tax rate. Enterprise has no limit.</p>
        <ul class="mt-auto flex flex-wrap gap-2 pt-8" aria-hidden="true">
          {['Gulberg', 'DHA Phase 5', 'Johar Town'].map((b) => (
            <li class="caption-1 flex items-center gap-2 rounded-full bg-surface px-3 py-1"><span class="size-2 rounded-full bg-brand" />{b}</li>
          ))}
        </ul>
      </article>

    </div>

    <AllFeatures />
  </div>
</section>
