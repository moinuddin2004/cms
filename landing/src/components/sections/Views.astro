---
import Icon from '../Icon.astro';
import IconChip from '../IconChip.astro';
import SectionHead from '../SectionHead.astro';

const pills = [
  ['calendar-check', 'Booked and walk in patients'],
  ['users-three', 'A line for every doctor'],
  ['ticket', 'Printed token slips'],
  ['television-simple', 'Waiting room TV'],
];
---

<section id="features" class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <SectionHead eyebrow="The patient queue">
      <Fragment slot="lead">Check in once.</Fragment>
      <Fragment slot="rest">Every <IconChip name="monitor" tone="amber" /> screen knows.</Fragment>
      Reception, the doctor’s room and the waiting room TV share one live queue, so nobody has to ask who is next.
    </SectionHead>

    <ul class="reveal mt-8 flex flex-wrap justify-center gap-2">
      {
        pills.map(([icon, label]) => (
          <li class="caption-1 flex items-center gap-2 rounded-full border border-line px-3 py-2 text-ink">
            <Icon name={icon} class="size-4 text-steel" />
            {label}
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-12 rounded-[28px] bg-panel p-4 sm:p-10">
      <div class="grid items-center gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
        <!-- Reception -->
        <div>
          <p class="caption-1 mb-3 flex items-center gap-2 text-steel"><Icon name="desktop" class="size-4" />Reception</p>
          <div class="rounded-2xl bg-surface p-4 shadow-xl shadow-ink/5">
            <p class="body-4">Check in</p>
            <div class="mt-3 space-y-2">
              <div class="rounded-xl border border-line px-3 py-2">
                <p class="caption-5 text-steel">Patient</p>
                <p class="body-5">Mehwish Ali</p>
              </div>
              <div class="rounded-xl border border-line px-3 py-2">
                <p class="caption-5 text-steel">Doctor</p>
                <p class="body-5">Dr. Ayesha Khan</p>
              </div>
            </div>
            <div class="mt-3 flex items-center justify-between rounded-xl bg-mint px-3 py-2">
              <p class="body-5 text-mint-strong">Token A15 issued</p>
              <Icon name="printer" class="size-4 text-mint-strong" />
            </div>
          </div>
        </div>

        <span class="connector" aria-hidden="true"><Icon name="arrow-right" class="size-4" /></span>

        <!-- Doctor -->
        <div>
          <p class="caption-1 mb-3 flex items-center gap-2 text-steel"><Icon name="stethoscope" class="size-4" />Doctor’s room</p>
          <div class="rounded-2xl bg-surface p-4 shadow-xl shadow-ink/5">
            <div class="flex items-center justify-between">
              <p class="body-4">My queue</p>
              <span class="caption-3 rounded-full bg-panel px-2 py-0.5 text-steel">4 waiting</span>
            </div>
            <ul class="mt-2 divide-y divide-line">
              {[
                ['A15', 'Mehwish Ali', true],
                ['A16', 'Usman Farooq', false],
                ['A17', 'Zainab Qureshi', false],
              ].map(([t, n, now]) => (
                <li class="flex items-center gap-3 py-2">
                  <span class="caption-3 printed w-8">{t}</span>
                  <span class="caption-2 min-w-0 flex-1 truncate">{n}</span>
                  {now ? <span class="caption-3 rounded-full bg-mint px-2 py-0.5 text-mint-strong">Called</span> : null}
                </li>
              ))}
            </ul>
            <span class="btn btn-primary button-sm mt-3 w-full rounded-full">Call next patient</span>
          </div>
        </div>

        <span class="connector" aria-hidden="true"><Icon name="arrow-right" class="size-4" /></span>

        <!-- TV -->
        <div>
          <p class="caption-1 mb-3 flex items-center gap-2 text-steel"><Icon name="television-simple" class="size-4" />Waiting room</p>
          <div class="rounded-2xl bg-display p-6 text-center text-white shadow-xl shadow-ink/10">
            <p class="caption-1 text-white/50">Now serving</p>
            <p class="tv-token led-dots mt-2">A15</p>
            <p class="body-5 mt-3">Room 2 · Dr. Ayesha Khan</p>
            <p class="caption-5 mt-1 text-white/50">Next: A16 · A17 · A18</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tv-token {
    font-family: var(--font-mono);
    font-size: var(--text-7xl);
    line-height: 1;
    font-weight: 700;
    color: #f4a62a;
  }
  .connector {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: 0 auto;
    border-radius: 9999px;
    background: var(--surface);
    color: var(--steel);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }
  @media (max-width: 1023px) {
    .connector { transform: rotate(90deg); }
  }
</style>
