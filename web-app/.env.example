# API
VITE_API_BASE_URL=http://localhost:5000

# Patient-app landing page (/c/:token)
# Deep-link scheme of the installed app: clinicapp-dev (dev build),
# clinicapp-preview (preview build), clinicapp (production). Default: clinicapp
VITE_APP_SCHEME=clinicapp
# Store listings shown when the app is not installed (leave empty until published)
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
